{
  "name": "bancaemdia-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/build-csp.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && pnpm lint:palette && pnpm lint:formatters && pnpm format:check",
    "lint:formatters": "node scripts/check-formatters.mjs",
    "lint:palette": "node scripts/check-palette.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen-types": "node scripts/gen-types.mjs",
    "prepare": "husky",
    "precommit": "lint-staged --no-stash && pnpm typecheck",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "measure:lighthouse": "node scripts/measure-lighthouse.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "chrome-launcher": "1.2.1",
    "color-name": "2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "jsdom": "^26.1.0",
    "lighthouse": "13.5.0",
    "lint-staged": "^16.0.0",
    "msw": "^2.0.0",
    "openapi-typescript": "^7.0.0",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --max-warnings 0",
    "*": "prettier --check --ignore-unknown"
  }
}
