# bancaemdia-frontend — variáveis públicas (todas embutidas no bundle; nunca use segredo aqui)
# Dev: copie para .env; somente VITE_API_URL é obrigatória.
# Build publicado: /config.json sobrescreve as três variáveis abaixo sem rebuild.
# Nunca copie DATABASE_URL, JWT_SECRET_KEY ou ANTHROPIC_API_KEY do backend.

# URL base da API bancaemdia-api
# local:   http://127.0.0.1:8000
# staging: https://staging-api.bancaemdia.example.com
VITE_API_URL=http://127.0.0.1:8000

# Ambiente; mesmo vocabulário de APP_ENV do backend (sem o modo interno testing).
# Se omitido: development no dev server, production no build publicado.
# development | staging | production
VITE_APP_ENV=development

# Provedor de identidade (ADR 003) — reservado para #11, não consumido pela #2.
# Não colocar estes campos em /config.json até a integração de autenticação.
# JWKS da API valida o JWT; o provedor emissor
# é configurado aqui quando definido no backend (JWT_ISSUER/JWT_AUDIENCE).
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_AUDIENCE=

# Poll do job de upload (ms). ADR 005/017: inicia 1000, backoff em falhas.
# Inteiro de 1 a 2147483647; omitido usa 1000. Não controla timeouts internos da API.
VITE_UPLOAD_POLL_MS=1000
